  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vallesca007-web/nail-studio/issues"
  },
  "homepage": "https://github.com/vallesca007-web/nail-studio#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}

{
  "name": "anne_nail_studio",
  "version": "1.0.0",
  "description": "Aplicación Flutter para Anne Nail Studio. Las citas se guardan en MySQL a través de una API Node.js; la app nunca se conecta directamente a MySQL.",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "npm --prefix backend test",
    "db:setup": "npm --prefix backend run db:setup",
    "db:schema": "npm --prefix backend run db:schema",
    "db:seed": "npm --prefix backend run db:seed",
    "db:check": "npm --prefix backend run db:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vallesca007-web/nail-studio.git"
  },
  "keywords": [],
  "author": "",

# Copia este archivo a .env o ejecuta: npm run env:init
# env:init genera DB_PASSWORD y JWT_SECRET si estan vacios.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anne_nail_studio
DB_USER=anne_nail_app
DB_PASSWORD=
JWT_SECRET=

# Google Calendar es opcional: sin calendario ni credenciales la agenda se
# controla solo con MySQL.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./backend/.credentials/service-account.json
GOOGLE_OAUTH_CLIENT_ID=

TIMEZONE=America/Mexico_City
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
BUSINESS_CLOSE_MINUTE=0
BUSINESS_DAYS=1,2,3,4,5,6

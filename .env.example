MYSQL_ROOT_PASSWORD=change-this-root-password
DB_PASSWORD=change-this-app-password
GOOGLE_CALENDAR_ID=your-studio-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CREDENTIALS_DIR=./backend/.credentials
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google/service-account.json
GOOGLE_OAUTH_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
TIMEZONE=America/Mexico_City
BUSINESS_OPEN_HOUR=10
BUSINESS_CLOSE_HOUR=19
BUSINESS_CLOSE_MINUTE=30
BUSINESS_DAYS=1,2,3,4,5,6
SLOT_INTERVAL_MINUTES=30
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-secret
